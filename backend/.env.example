# npm run setup creates backend/.env with a project-specific password.
# Use this example only when configuring a database manually.
# Replace CHANGE_ME with that database's password; do not commit .env.
DATABASE_URL=postgresql://self_fit:CHANGE_ME@127.0.0.1:55432/self_fit?schema=public
TEST_DATABASE_URL=postgresql://self_fit:CHANGE_ME@127.0.0.1:55432/self_fit_test?schema=public
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: absolute path outside the public web directory.
# Without this setting the API uses the project's .data/attachments directory.
# STORAGE_DIR=/absolute/path/to/private-attachments
# FFPROBE_PATH=/absolute/path/to/ffprobe

# Configure all three only when enabling real browser push notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
