{
  "name": "self-fit-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "bootstrap-teacher": "node --env-file-if-exists=.env scripts/bootstrap-teacher.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "file-type": "21.3.4",
    "helmet": "8.1.0",
    "multer": "2.4.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {"prisma": "6.19.0"}
}
