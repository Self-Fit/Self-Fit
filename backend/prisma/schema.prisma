generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id                 String @id @default(uuid())
  role               String
  studentNumber      String @unique
  name               String
  grade              Int?
  classNumber        Int?
  targetType         String?
  fitnessGrade       Int?
  fitnessGradeYear   Int?
  fitnessGradeSemester Int?
  passwordHash       String
  mustChangePassword Boolean @default(true)
  weekendReminder    Boolean @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  sessions           Session[]
  records            DailyRecord[]
  notifications      Notification[]
  subscriptions      PushSubscription[]
  requestedCorrections Correction[] @relation("requester")
  decidedCorrections Correction[] @relation("decider")
  imports            RosterImport[]
  sourceRows         StudentSource[]
  fitnessAssessments StudentFitnessAssessment[]
  createdChallenges  Challenge[] @relation("challengeCreator")
  memberships        ChallengeMembership[] @relation("challengeMember")
  invitedMemberships ChallengeMembership[] @relation("challengeInviter")
  @@index([role, grade, classNumber])
  @@index([role, fitnessGrade, grade, classNumber])
}
model Session {
  id        String @id
  userId    String
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  pushDeviceKeyHash String? @db.VarChar(64)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model DailyRecord {
  id          String @id @default(uuid())
  userId      String
  user        User @relation(fields:[userId], references:[id], onDelete:Restrict)
  challengeId String
  challenge   Challenge @relation(fields:[challengeId], references:[id], onDelete:Restrict)
  date        String
  value       Json
  sourceDatasetId String?
  sourceDataset SourceDataset? @relation(fields:[sourceDatasetId], references:[id], onDelete:Restrict)
  sourceMetadata Json?
  version     Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attachments Attachment[]
  corrections Correction[]
  revisions   RecordRevision[]
  @@unique([challengeId, userId, date])
  @@index([userId, date])
  @@index([date])
  @@index([sourceDatasetId])
}
model SourceDataset {
  id           String @id @default(uuid())
  hash         String @unique @db.VarChar(64)
  filename     String
  metadataJson Json
  importedAt   DateTime @default(now())
  sourceRows   StudentSource[]
  records      DailyRecord[]
  fitnessAssessments StudentFitnessAssessment[]
}
model StudentFitnessAssessment {
  id              String @id @default(uuid())
  userId          String
  user            User @relation(fields:[userId], references:[id], onDelete:Restrict)
  year            Int
  semester        Int
  grade           Int
  score           Float?
  sourceDatasetId String
  sourceDataset   SourceDataset @relation(fields:[sourceDatasetId], references:[id], onDelete:Restrict)
  sourceSheet     String
  sourceRow       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([userId, year, semester])
  @@index([sourceDatasetId])
}
model StudentSource {
  id           String @id @default(uuid())
  datasetId    String
  dataset      SourceDataset @relation(fields:[datasetId], references:[id], onDelete:Restrict)
  userId       String
  user         User @relation(fields:[userId], references:[id], onDelete:Restrict)
  rosterJson   Json
  fitnessJson  Json?
  metadataJson Json?
  @@unique([datasetId, userId])
  @@index([userId])
}
model RecordRevision {
  id        String @id @default(uuid())
  recordId  String
  record    DailyRecord @relation(fields:[recordId], references:[id], onDelete:Restrict)
  value     Json
  version   Int
  actorId   String
  source    String
  createdAt DateTime @default(now())
  @@index([recordId])
}
model Attachment {
  id           String @id @default(uuid())
  recordId     String
  record       DailyRecord @relation(fields:[recordId], references:[id], onDelete:Restrict)
  name         String
  storageKey   String @unique
  kind         String
  mimeType     String
  size         Int
  duration     Float?
  createdAt    DateTime @default(now())
  @@index([recordId])
}
model Correction {
  id             String @id @default(uuid())
  recordId       String
  record         DailyRecord @relation(fields:[recordId], references:[id], onDelete:Restrict)
  requesterId    String
  requester      User @relation("requester", fields:[requesterId], references:[id], onDelete:Restrict)
  deciderId      String?
  decider        User? @relation("decider", fields:[deciderId], references:[id], onDelete:Restrict)
  beforeValue    Json
  requestedValue Json
  baseVersion    Int
  reason         String
  status         String @default("pending")
  decisionReason String?
  createdAt      DateTime @default(now())
  decidedAt      DateTime?
  @@index([status, createdAt])
  @@index([recordId])
}
model Notification {
  id         String @id @default(uuid())
  userId     String
  user       User @relation(fields:[userId], references:[id], onDelete:Cascade)
  eventKey   String @unique
  type       String
  title      String
  body       String
  data       Json?
  readAt     DateTime?
  createdAt  DateTime @default(now())
  pushState  String @default("pending")
  attempts   Int @default(0)
  nextTryAt  DateTime @default(now())
  deliveredEndpoints Json @default("[]")
  @@index([userId, createdAt])
  @@index([pushState, nextTryAt])
}
model PushSubscription {
  id        String @id @default(uuid())
  userId    String
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  endpoint  String @unique
  p256dh    String
  auth      String
  deviceKeyHash String? @db.VarChar(64)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([deviceKeyHash])
}
model RosterImport {
  id        String @id @default(uuid())
  teacherId String
  teacher   User @relation(fields:[teacherId], references:[id], onDelete:Cascade)
  rows      Json
  consumed  Boolean @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Challenge {
  id                 String @id @default(uuid())
  title              String
  description        String @default("")
  year               Int
  lifecycle          String @default("draft")
  startDate          String
  endDate            String
  enrollmentDeadline String
  sourceChallengeId  String?
  sourceChallenge    Challenge? @relation("challengeSource", fields:[sourceChallengeId], references:[id], onDelete:SetNull)
  copies             Challenge[] @relation("challengeSource")
  createdById        String?
  createdBy          User? @relation("challengeCreator", fields:[createdById], references:[id], onDelete:SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  weeks              ChallengeWeek[]
  memberships        ChallengeMembership[]
  records            DailyRecord[]
  @@index([lifecycle, startDate])
}
model ChallengeWeek {
  id           String @id @default(uuid())
  challengeId  String
  challenge    Challenge @relation(fields:[challengeId], references:[id], onDelete:Cascade)
  week         Int
  title        String
  startDate    String
  endDate      String
  inputType    String
  weeklyTarget Float
  dailyTarget  Float?
  unit         String
  dailyUnit    String?
  color        String
  description  String @default("")
  exercises    Json?
  @@unique([challengeId, week])
}
model ChallengeMembership {
  id          String @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields:[challengeId], references:[id], onDelete:Cascade)
  userId      String
  user        User @relation("challengeMember", fields:[userId], references:[id], onDelete:Cascade)
  mode        String
  status      String
  invitedById String?
  invitedBy   User? @relation("challengeInviter", fields:[invitedById], references:[id], onDelete:SetNull)
  invitedAt   DateTime @default(now())
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([challengeId, userId])
  @@index([userId, status])
}
